<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted so the app can be pointed at a plain-HTTP test
  server on the local network (e.g. an iperf-style box or a router-hosted file)
  in the settings sheet. Public test servers are still reached over HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
